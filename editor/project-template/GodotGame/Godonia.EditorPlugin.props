<Project>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GodoniaInjectHostScripts>false</GodoniaInjectHostScripts>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<!-- In-repo samples: ProjectReference. Shipped games: PackageReference from editor-local nupkg. -->
		<_GodoniaProjectPath>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\src\Ouse.Godonia\Ouse.Godonia.csproj'))</_GodoniaProjectPath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(_GodoniaProjectPath)" Condition="Exists('$(_GodoniaProjectPath)')" />
		<PackageReference Include="Ouse.Godonia" Condition="!Exists('$(_GodoniaProjectPath)')" />
	</ItemGroup>

</Project>
