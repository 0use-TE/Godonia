<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:HelloWorld.Editor.SkillTree"
	mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="520"
	x:Class="HelloWorld.Editor.SkillTree.SkillTreeView"
	x:Name="Root"
	x:DataType="vm:SkillTreeViewModel">
	<DockPanel Margin="12">
		<StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
			<TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
			<TextBlock Text="{Binding Status}" Opacity="0.8" TextWrapping="Wrap" />
			<TextBlock Text="{Binding PointsText}" FontWeight="Medium" />
		</StackPanel>
		<Button DockPanel.Dock="Bottom" Content="Reset tree" Command="{Binding ResetCommand}" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
		<ScrollViewer>
			<ItemsControl ItemsSource="{Binding Skills}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:SkillNode">
						<Border Margin="0,0,0,8" Padding="10" CornerRadius="8" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
							<DockPanel>
								<Button DockPanel.Dock="Right" Content="+" Width="36"
									Command="{Binding #Root.((vm:SkillTreeViewModel)DataContext).UnlockCommand}"
									CommandParameter="{Binding}"
									IsEnabled="{Binding CanUnlock}" />
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
									<TextBlock Text="{Binding Description}" Opacity="0.75" TextWrapping="Wrap" FontSize="12" />
									<TextBlock Text="{Binding RankText}" FontSize="11" Opacity="0.9" />
								</StackPanel>
							</DockPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</DockPanel>
</UserControl>