<Project>

	<PropertyGroup>
		<!-- Original author (MIT) — keep attribution -->
		<Authors>Julien Lebosquain</Authors>
		<Product>Godonia</Product>
		<Copyright>Copyright © Julien Lebosquain and contributors</Copyright>
		<Version>1.0.0</Version>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<Import Project="$(MSBuildThisFileDirectory)src\Ouse.Godonia\build\Ouse.Godonia.props"
		Condition="Exists('$(MSBuildThisFileDirectory)src\Ouse.Godonia\build\Ouse.Godonia.props')" />

</Project>
